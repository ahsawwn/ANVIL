QMainWindow, QWidget {
    background-color: #1e2228;
    color: #d5dbe2;
    font-family: "JetBrains Mono", "Fira Code", "DejaVu Sans Mono", monospace;
    font-size: 13px;
}

QTabWidget::pane {
    border: 1px solid #2c323b;
    background-color: #1e2228;
    top: -1px;
}

QTabBar::tab {
    background-color: #262b33;
    color: #9aa4b2;
    padding: 8px 22px;
    border: 1px solid #2c323b;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #2c323b;
    color: #4fc3f7;
    border-bottom: 2px solid #4fc3f7;
}

QTabBar::tab:hover:!selected {
    background-color: #2a3038;
    color: #d5dbe2;
}

QLineEdit, QComboBox, QPlainTextEdit, QTextEdit, QListView, QTreeView {
    background-color: #16191d;
    color: #d5dbe2;
    border: 1px solid #343b45;
    border-radius: 4px;
    padding: 5px 7px;
    selection-background-color: #2f6f9f;
    selection-color: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #4fc3f7;
}

QLineEdit:disabled, QComboBox:disabled, QPlainTextEdit:disabled {
    background-color: #232830;
    color: #6b7684;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #9aa4b2;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: #20252c;
    border: 1px solid #343b45;
    selection-background-color: #2f6f9f;
    selection-color: #ffffff;
}

QPushButton {
    background-color: #2c333d;
    color: #d5dbe2;
    border: 1px solid #3a424e;
    border-radius: 4px;
    padding: 6px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #343c48;
    border-color: #4fc3f7;
}

QPushButton:pressed {
    background-color: #232a33;
}

QPushButton:disabled {
    background-color: #232830;
    color: #5c6773;
    border-color: #2c323b;
}

QPushButton#startButton {
    background-color: #1b5e20;
    border-color: #2e7d32;
    color: #c8e6c9;
}

QPushButton#startButton:hover {
    background-color: #2e7d32;
}

QPushButton#startButton:disabled {
    background-color: #233028;
    color: #4f5b50;
    border-color: #2c323b;
}

QPushButton#stopButton {
    background-color: #7f1d1d;
    border-color: #b71c1c;
    color: #ffcdd2;
}

QPushButton#stopButton:hover {
    background-color: #b71c1c;
}

QPushButton#stopButton:disabled {
    background-color: #2c2328;
    color: #6b5050;
    border-color: #2c323b;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #4a5460;
    border-radius: 3px;
    background-color: #16191d;
}

QCheckBox::indicator:checked {
    background-color: #2f6f9f;
    border-color: #4fc3f7;
    image: none;
}

QCheckBox::indicator:hover {
    border-color: #4fc3f7;
}

QHeaderView::section {
    background-color: #262b33;
    color: #9aa4b2;
    padding: 6px 8px;
    border: none;
    border-right: 1px solid #343b45;
    border-bottom: 1px solid #343b45;
    font-weight: 700;
}

QTreeView {
    alternate-background-color: #22272e;
}

QTreeView::item {
    padding: 4px 6px;
}

QTreeView::item:hover {
    background-color: #2a3139;
}

QTreeView::item:selected {
    background-color: #2f6f9f;
    color: #ffffff;
}

QListWidget, QListView {
    alternate-background-color: #22272e;
}

QListWidget::item {
    padding: 4px 6px;
}

QListWidget::item:selected {
    background-color: #2f6f9f;
    color: #ffffff;
}

QScrollBar:vertical {
    background-color: #1e2228;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #3a424e;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4fc3f7;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #1e2228;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #3a424e;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QStatusBar {
    background-color: #171a1f;
    color: #9aa4b2;
    border-top: 1px solid #2c323b;
}

QStatusBar::item {
    border: none;
}

QSplitter::handle {
    background-color: #2c323b;
    width: 4px;
}

QToolTip {
    background-color: #2c323b;
    color: #d5dbe2;
    border: 1px solid #4fc3f7;
    padding: 4px 6px;
}

QMenuBar {
    background-color: #171a1f;
    color: #d5dbe2;
}

QMenuBar::item:selected {
    background-color: #2f6f9f;
    color: #ffffff;
}

QMenu {
    background-color: #20252c;
    color: #d5dbe2;
    border: 1px solid #343b45;
}

QMenu::item:selected {
    background-color: #2f6f9f;
    color: #ffffff;
}

QMessageBox {
    background-color: #1e2228;
}

QGroupBox {
    border: 1px solid #343b45;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #4fc3f7;
}

QLabel {
    color: #9aa4b2;
}
